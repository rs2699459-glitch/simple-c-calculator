#include <stdio.h>
#include <stdlib.h>
#include <math.h>

// UI Layout Structures
#define BORDER "========================================="
#define DIVIDER "-----------------------------------------"

void print_header() {
    printf("\n%s\n", BORDER);
    printf("       ✨ SIMPLE C CALCULATOR ✨       \n");
    printf("%s\n", BORDER);
}

void print_menu() {
    printf("\nSelect an operation:\n");
    printf("  1. Addition (+)\n");
    printf("  2. Subtraction (-)\n");
    printf("  3. Multiplication (*)\n");
    printf("  4. Division (/)\n");
    printf("  5. Power (x^y)\n");
    printf("  6. Square Root (√x)\n");
    printf("  7. Exit Program\n");
}

int main() {
    int choice;
    double num1, num2, result;

    print_header();

    while (1) {
        print_menu();
        printf("\nEnter your choice (1-7): ");
        
        if (scanf("%d", &choice) != 1) {
            printf("\n❌ Invalid input. Terminating application.\n");
            break;
        }

        if (choice == 7) {
            printf("\n%s\n", DIVIDER);
            printf(" Thank you for using C Calculator! Goodbye.\n");
            printf("%s\n", BORDER);
            break;
        }

        if (choice < 1 || choice > 7) {
            printf("\n❌ Error: Please choose an option between 1 and 7.\n");
            printf("%s\n", DIVIDER);
            continue;
        }

        // Single-input operation
        if (choice == 6) {
            printf("Enter number: ");
            scanf("%lf", &num1);
            if (num1 < 0) {
                printf("\n⚠️ Math Error: Cannot calculate square root of a negative number.\n");
            } else {
                result = sqrt(num1);
                printf("\n✅ Result: √x(%.4lf) = %.4lf\n", num1, result);
            }
            printf("\n%s\n", DIVIDER);
            continue;
        }

        // Dual-input operations
        printf("Enter first number: ");
        scanf("%lf", &num1);
        printf("Enter second number: ");
        scanf("%lf", &num2);

        switch (choice) {
            case 1:
                printf("\n✅ Result: %.4lf + %.4lf = %.4lf\n", num1, num2, num1 + num2);
                break;
            case 2:
                printf("\n✅ Result: %.4lf - %.4lf = %.4lf\n", num1, num2, num1 - num2);
                break;
            case 3:
                printf("\n✅ Result: %.4lf * %.4lf = %.4lf\n", num1, num2, num1 * num2);
                break;
            case 4:
                if (num2 == 0) {
                    printf("\n⚠️ Math Error: Division by zero is undefined.\n");
                } else {
                    printf("\n✅ Result: %.4lf / %.4lf = %.4lf\n", num1, num2, num1 / num2);
                }
                break;
            case 5:
                printf("\n✅ Result: %.4lf ^ %.4lf = %.4lf\n", num1, num2, pow(num1, num2));
                break;
        }
        printf("\n%s\n", DIVIDER);
    }

    return 0;
}